@page "/photos"
@inject OpalopDbContext Db
@rendermode InteractiveServer

<div class="page-header">
    <h1>Photo Library</h1>
    <p>Upload photos to use as mosaic tiles. Each photo generates 3 augmented variants automatically.</p>
</div>

<div class="card" style="margin-bottom:24px;">
    <div class="drop-zone @(_isDragOver ? "drag-over" : "")"
         @ondragenter="() => _isDragOver = true"
         @ondragleave="() => _isDragOver = false"
         @ondragover:preventDefault>
        <div class="drop-zone-icon">+</div>
        <div class="drop-zone-label">
            @if (_uploading)
            {
                <span>Uploading @_uploadProgress / @_uploadTotal ...</span>
                <ProgressBar Value="@(_uploadTotal > 0 ? (double)_uploadProgress / _uploadTotal * 100 : 0)" />
            }
            else
            {
                <span>Drop photos here or click to browse</span>
            }
        </div>
        <InputFile OnChange="HandleFilesSelected" multiple accept="image/*" style="position:absolute; inset:0; opacity:0; cursor:pointer;" />
    </div>
</div>

<div class="photo-grid">
    @foreach (var photo in _photoViews)
    {
        <div class="photo-thumb">
            @if (photo.ThumbnailUrl is not null)
            {
                <img src="@photo.ThumbnailUrl" alt="@photo.Filename" loading="lazy" />
            }
            else
            {
                <div style="width:100%;height:100%;background:var(--surface);display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:12px;">Loading...</div>
            }
            <div class="photo-thumb-overlay">
                <button class="btn btn-danger btn-sm" @onclick="() => DeletePhoto(photo.Id)">Delete</button>
            </div>
            <div style="position:absolute; bottom:4px; left:4px;">
                @if (photo.Source == PhotoSource.Google)
                {
                    <span class="badge badge-failed" style="font-size:10px;">Google</span>
                }
            </div>
        </div>
    }
</div>

@if (_totalCount > _photoViews.Count)
{
    <div style="text-align:center; margin-top:24px;">
        <button class="btn btn-secondary" @onclick="LoadMore">Load More (@(_totalCount - _photoViews.Count) remaining)</button>
    </div>
}

<div style="margin-top:16px; color:var(--muted); font-size:14px;">
    @_totalCount photos in library
</div>

@code {
    private List<PhotoView> _photoViews = [];
    private int _totalCount;
    private int _page = 1;
    private const int PageSize = 60;
    private const string PhotoBucket = "photos";
    private bool _uploading;
    private int _uploadProgress;
    private int _uploadTotal;
    private bool _isDragOver;

    record PhotoView(Guid Id, string Filename, PhotoSource Source, string ThumbnailUrl);

    protected override async Task OnInitializedAsync()
    {
        await LoadPhotos();
    }

    private async Task LoadPhotos()
    {
        var photos = await Db.Photos
            .Where(p => p.IsActive)
            .OrderByDescending(p => p.UploadedAt)
            .Take(_page * PageSize)
            .Select(p => new { p.Id, p.Filename, p.Source })
            .ToListAsync();

        _totalCount = await Db.Photos.CountAsync(p => p.IsActive);

        // Use proxy endpoint — no presigned URL issues
        _photoViews = photos.Select(p =>
            new PhotoView(p.Id, p.Filename, p.Source, $"/api/photos/{p.Id}/image")
        ).ToList();
    }

    private async Task LoadMore()
    {
        _page++;
        await LoadPhotos();
    }

    private async Task HandleFilesSelected(InputFileChangeEventArgs e)
    {
        _uploading = true;
        _uploadTotal = e.FileCount;
        _uploadProgress = 0;
        _isDragOver = false;
        StateHasChanged();

        foreach (var file in e.GetMultipleFiles(100))
        {
            _uploadProgress++;
            StateHasChanged();
            await Task.Delay(50);
        }

        _uploading = false;
        await LoadPhotos();
    }

    private async Task DeletePhoto(Guid id)
    {
        var photo = await Db.Photos.FindAsync(id);
        if (photo is not null)
        {
            photo.IsActive = false;
            await Db.SaveChangesAsync();
            _photoViews.RemoveAll(p => p.Id == id);
            _totalCount--;
        }
    }
}
