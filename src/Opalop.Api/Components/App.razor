<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>OPALOP Admin</title>
    <HeadOutlet />
    <style>
        :root { --bg: #0f172a; --surface: #1e293b; --border: #334155; --text: #e2e8f0; --muted: #94a3b8; --accent: #60a5fa; --success: #6ee7b7; --warning: #fcd34d; }
        * { margin:0; padding:0; box-sizing:border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: var(--bg); color: var(--text); }
        a { color: var(--accent); text-decoration: none; }
        table { width:100%; border-collapse:collapse; font-size:14px; }
        th { text-align:left; padding:10px; color:var(--muted); border-bottom:2px solid var(--border); }
        td { padding:10px; border-bottom:1px solid var(--border); }
        .card { background:var(--surface); border-radius:8px; padding:20px; }
        .stat { text-align:center; }
        .stat-value { font-size:32px; font-weight:bold; }
        .stat-label { color:var(--muted); font-size:14px; margin-top:4px; }
        .badge { display:inline-block; padding:2px 8px; border-radius:4px; font-size:12px; }
        .badge-completed { background:#064e3b; color:#6ee7b7; }
        .badge-processing { background:#1c1917; color:#fcd34d; }
        .badge-failed { background:#450a0a; color:#fca5a5; }
        .badge-queued { background:#312e81; color:#a5b4fc; }
    </style>
</head>
<body>
    <Routes />
</body>
</html>
